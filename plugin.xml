<?xml version="1.0" encoding="UTF-8"?>
<plugin

    id="cordova-plugin-app-icon-changer"

    version="2.0.1"

    xmlns="http://apache.org/cordova/ns/plugins/1.0"

    xmlns:android="http://schemas.android.com/apk/res/android">
<name>App Icon Changer</name>
<description>Change App icon at runtime</description>
<license>MIT</license>
<!-- JavaScript interface -->
<js-module name="AppIconChanger" src="www/AppIconChanger.js">
<clobbers target="AppIconChanger" />
</js-module>
<platform name="android">
<!-- Hook to strip LAUNCHER category from MainActivity cleanly during build -->
<hook type="after_prepare" src="scripts/remove_main_launcher.js" />
<!-- Register plugin -->
<config-file target="res/xml/config.xml" parent="/*">
<feature name="AppIconChanger">
<param name="android-package"

                       value="com.cordova.changeappicon.ChangeAppIcon" />
</feature>
</config-file>
<!-- Java source files -->
<source-file

            src="src/android/ChangeAppIcon.java"

            target-dir="src/com/cordova/changeappicon" />
<source-file

            src="src/android/UpgradeReceiver.java"

            target-dir="src/com/cordova/changeappicon" />
<!-- Android launcher icon drawables -->
<resource-file src="src/android/icons/app_light.png" target="res/drawable/app_light.png"/>
<resource-file src="src/android/icons/app_dark.png" target="res/drawable/app_dark.png"/>
<resource-file src="src/android/icons/app_private.png" target="res/drawable/app_private.png"/>
<config-file target="AndroidManifest.xml" parent="/manifest/application">
<!-- Self-heal receiver on app upgrade -->
<receiver

                android:name="com.cordova.changeappicon.UpgradeReceiver"

                android:exported="false">
<intent-filter>
<action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
</intent-filter>
</receiver>
<!-- Light (Enabled by default on fresh install) -->
<activity-alias

                android:name=".Light"

                android:enabled="true"

                android:icon="@drawable/app_light"

                android:exported="true"

                android:targetActivity=".MainActivity">
<intent-filter>
<action android:name="android.intent.action.MAIN"/>
<category android:name="android.intent.category.LAUNCHER"/>
</intent-filter>
</activity-alias>
<!-- Dark -->
<activity-alias

                android:name=".Dark"

                android:enabled="false"

                android:icon="@drawable/app_dark"

                android:exported="true"

                android:targetActivity=".MainActivity">
<intent-filter>
<action android:name="android.intent.action.MAIN"/>
<category android:name="android.intent.category.LAUNCHER"/>
</intent-filter>
</activity-alias>
<!-- Private -->
<activity-alias

                android:name=".Private"

                android:enabled="false"

                android:icon="@drawable/app_private"

                android:exported="true"

                android:targetActivity=".MainActivity">
<intent-filter>
<action android:name="android.intent.action.MAIN"/>
<category android:name="android.intent.category.LAUNCHER"/>
</intent-filter>
</activity-alias>
</config-file>
</platform>
<platform name="ios">
<config-file parent="/*" target="config.xml">
<feature name="AppIconChanger">
<param name="ios-package" value="AppIconChanger" />
</feature>
</config-file>
<header-file src="src/ios/AppIconChanger.h" />
<source-file src="src/ios/AppIconChanger.m" />
<!-- LIGHT -->
<resource-file src="src/ios/icons/light.png" />
<resource-file src="src/ios/icons/light@2x.png" />
<resource-file src="src/ios/icons/light@3x.png" />
<!-- DARK -->
<resource-file src="src/ios/icons/dark.png" />
<resource-file src="src/ios/icons/dark@2x.png" />
<resource-file src="src/ios/icons/dark@3x.png" />
<!-- PRIVATE -->
<resource-file src="src/ios/icons/private.png" />
<resource-file src="src/ios/icons/private@2x.png" />
<resource-file src="src/ios/icons/private@3x.png" />
<config-file target="*-Info.plist" parent="CFBundleIcons">
<dict>
<key>CFBundleAlternateIcons</key>
<dict>
<key>light</key>
<dict>
<key>CFBundleIconFiles</key>
<array>
<string>light</string>
</array>
</dict>
<key>dark</key>
<dict>
<key>CFBundleIconFiles</key>
<array>
<string>dark</string>
</array>
</dict>
<key>private</key>
<dict>
<key>CFBundleIconFiles</key>
<array>
<string>private</string>
</array>
</dict>
</dict>
</dict>
</config-file>
</platform>
</plugin>
 

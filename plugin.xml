<?xml version="1.0" encoding="UTF-8"?>
<plugin
    id="cordova-plugin-app-icon-changer"
    version="1.0.1"
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
      xmlns:tools="http://schemas.android.com/tools">

    <name>App Icon Changer</name>
    <description>Change iOS app icon at runtime</description>
    <license>MIT</license>

    <!-- JavaScript interface -->
    <js-module name="AppIconChanger" src="www/AppIconChanger.js">
        <clobbers target="AppIconChanger" />
    </js-module>

    <!-- Android configuration -->
    <platform name="android">

        <!-- Java source files -->
        <source-file
            src="src/android/ChangeAppIcon.java"
            target-dir="src/com/cordova/changeappicon" />

        <source-file
            src="src/android/UpgradeReceiver.java"
            target-dir="src/com/cordova/changeappicon" />

        <!-- Remove only the MAIN / LAUNCHER intent filter from MainActivity.
             Do not remove MainActivity itself. -->
        <config-file
            target="AndroidManifest.xml"
            parent="/manifest/application">

            <activity
                android:name=".MainActivity"
                tools:node="merge">

                <intent-filter tools:node="remove">
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>

            </activity>

        </config-file>

        <!-- Launcher aliases -->
        <config-file
            target="AndroidManifest.xml"
            parent="/manifest/application">

            <activity-alias
                android:name=".Light"
                android:targetActivity=".MainActivity"
                android:enabled="true"
                android:exported="true"
                android:icon="@mipmap/ic_launcher"
                android:label="@string/app_name">

                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>

            </activity-alias>

            <activity-alias
                android:name=".Dark"
                android:targetActivity=".MainActivity"
                android:enabled="false"
                android:exported="true"
                android:icon="@mipmap/ic_launcher_dark"
                android:label="@string/app_name">

                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>

            </activity-alias>

            <activity-alias
                android:name=".Private"
                android:targetActivity=".MainActivity"
                android:enabled="false"
                android:exported="true"
                android:icon="@mipmap/ic_launcher_private"
                android:label="@string/app_name">

                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />
                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>

            </activity-alias>

        </config-file>

        <!-- Restore the selected launcher icon after application upgrade -->
        <config-file
            target="AndroidManifest.xml"
            parent="/manifest/application">

            <receiver
                android:name="com.cordova.changeappicon.UpgradeReceiver"
                android:enabled="true"
                android:exported="false">

                <intent-filter>
                    <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                </intent-filter>

            </receiver>

        </config-file>

    </platform>


    <platform name="ios">

        <!-- ✅ REQUIRED: Register native plugin with Cordova -->
        <config-file parent="/*" target="config.xml">
            <feature name="AppIconChanger">
                <param name="ios-package" value="AppIconChanger" />
            </feature>
        </config-file>

        <!-- Native source files -->
        <header-file src="src/ios/AppIconChanger.h" />
        <source-file src="src/ios/AppIconChanger.m" />

        <!-- ✅ Icon files copied into app bundle -->
        <!-- LIGHT -->
        <resource-file src="src/ios/icons/light.png" />
        <resource-file src="src/ios/icons/light@2x.png" />
        <resource-file src="src/ios/icons/light@3x.png" />

        <!-- DARK -->
        <resource-file src="src/ios/icons/dark.png" />
        <resource-file src="src/ios/icons/dark@2x.png" />
        <resource-file src="src/ios/icons/dark@3x.png" />

        <!-- PRIVATE -->
        <resource-file src="src/ios/icons/private.png" />
        <resource-file src="src/ios/icons/private@2x.png" />
        <resource-file src="src/ios/icons/private@3x.png" />

        <!-- ✅ Alternate icon declarations -->
        <config-file target="*-Info.plist" parent="CFBundleIcons">
            <dict>
                <key>CFBundleAlternateIcons</key>
                <dict>

                    <key>light</key>
                    <dict>
                        <key>CFBundleIconFiles</key>
                        <array>
                            <string>light</string>
                        </array>
                    </dict>

                    <key>dark</key>
                    <dict>
                        <key>CFBundleIconFiles</key>
                        <array>
                            <string>dark</string>
                        </array>
                    </dict>

                    <key>private</key>
                    <dict>
                        <key>CFBundleIconFiles</key>
                        <array>
                            <string>private</string>
                        </array>
                    </dict>

                </dict>
            </dict>
        </config-file>

    </platform>
</plugin>
